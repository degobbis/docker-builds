# Maintainer from the images
MAINTAINER="Guido De Gobbis"

# URL to this repository
GIT_REPOSITORY_URL="https://github.com/degobbis/docker-builds"

# Repository name on Dockerhub
DOCKER_HUB_REPOSITORY=""

# Prefix host:port to a registry container (local Dockerhub) https://hub.docker.com/_/registry
# needed to create images for miltiple platforms
DOCKER_HUB_REPOSITORY_LOCAL_PREFIX=""

BUILD_TZ="Europe/Berlin"

# Docker official alpine image
APACHE24_VERSION="2.4.66"
APACHE24_PLATFORMS="linux/386,linux/amd64,linux/arm/v6,linux/arm/v7,linux/arm64"

PHP_MODULES="bcmath bz2 calendar exif gd gettext gmp imap intl ldap mysqli opcache pdo_mysql pdo_pgsql pgsql redis soap sockets xdebug xmlrpc xsl zip"
